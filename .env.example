# SQLite — copy this file to .env.local and adjust as needed.
# All values are optional; sensible defaults are shown below.

# Secret used to sign the admin session cookie (HMAC-SHA256).
# CHANGE THIS in production — anything signed with it can forge a session.
# The app refuses to sign or verify sessions in production while this is left
# at its default, so an unset SESSION_SECRET breaks login rather than silently
# running insecurely. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives (default: data/portofolio.db).
# DATABASE_PATH=data/portofolio.db

# Admin account used when seeding an EMPTY users table, which happens once on
# the very first request. Changing these later does NOT update an existing
# account — use `npm run admin:password` instead.
# The demo defaults below are for local development only; override both before
# you deploy.
ADMIN_EMAIL=admin@demo.dev
ADMIN_PASSWORD=demo1234

# Turso/libSQL remote storage. When TURSO_URL is set, the app uses Turso
# instead of the local SQLite file — set these on Vercel (Production).
# Create a free database at https://turso.tech then run:
#   turso db create portofolio && turso db show portofolio --url && turso db tokens create portofolio
# TURSO_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token>
#
# These are two SEPARATE databases. A password reset run against the local
# SQLite file does not affect the deployed site — point TURSO_URL at Turso
# (or run the reset from a machine that has the Turso credentials) to change
# the production account.
